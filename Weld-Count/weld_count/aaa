    def log(self, message):
        timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        self.text_log.append(f"[{timestamp}] {message}")

    def load_data_file(self):
        file_path, _ = QFileDialog.getOpenFileName(self, "选择数据文件", "", "CSV/Excel Files (*.csv *.xlsx *.xls);;All Files (*)")
        if file_path:
            try:
                df, enc, sep = DataLoaderEngine.load_file(file_path)
                self.df = df
                self.file_path = file_path
                self.is_big_data = len(df) > 100000
                self.log(f"成功加载文件: {file_path}, 编码: {enc}, 分隔符: {sep}, 行数: {len(df)}, 列数: {len(df.columns)}")
                self.update_data_ui()
            except Exception as e:
                QMessageBox.critical(self, "加载失败", f"文件解析出错:\n{str(e)}")
                self.log(f"文件加载失败: {str(e)}")

    def load_big_data_file(self):
        file_path, _ = QFileDialog.getOpenFileName(self, "选择大文件", "", "CSV Files (*.csv);;All Files (*)")
        if file_path:
            try:
                chunk_list = []
                chunk_size = 50000
                total_rows = 0
                for chunk in pd.read_csv(file_path, chunksize=chunk_size, low_memory=False):
                    chunk_list.append(chunk)
                    total_rows += len(chunk)
                    self.log(f"已加载分块行数: {total_rows}")
                self.df = pd.concat(chunk_list, ignore_index=True)
                self.file_path = file_path
                self.is_big_data = True
                self.log(f"大文件分块加载完毕，总行数: {len(self.df)}")
                self.update_data_ui()
            except Exception as e:
                QMessageBox.critical(self, "大文件加载失败", str(e))

    def generate_sample_data(self):
        np.random.seed(42)
        n = 5000
        data = {
            '年龄': np.random.randint(18, 70, n),
            '使用时长': np.random.exponential(10, n),
            '温度': np.random.normal(25, 5, n),
            '是否高峰': np.random.choice([0, 1], n, p=[0.7, 0.3]),
            '区域': np.random.choice(['华东', '华南', '华北', '西南'], n),
            '容量': np.random.normal(100, 15, n)
        }
        df = pd.DataFrame(data)
        # 引入 2% 缺失值
        for col in ['年龄', '温度', '容量']:
            mask = np.random.rand(n) < 0.02
            df.loc[mask, col] = np.nan

        self.df = df
        self.file_path = "sample_data.csv"
        self.is_big_data = False
        self.log("成功生成 5000 行示例数据集")
        self.update_data_ui()
        # 默认选中容量
        idx = self.combo_target.findText("容量")
        if idx >= 0:
            self.combo_target.setCurrentIndex(idx)

    def update_data_ui(self):
        if self.df is None:
            return
        rows, cols = self.df.shape
        mem_usage = self.df.memory_usage(deep=True).sum()
        mem_str = f"{mem_usage / 1024 / 1024:.2f} MB" if mem_usage > 1024*1024 else f"{mem_usage / 1024:.2f} KB"
        
        status_text = f"数据量: {rows}行 × {cols}列 | 内存: {mem_str}"
        if self.is_big_data:
            status_text += " [大数据集模式]"
        self.lbl_data_info.setText(status_text)

        # 更新目标变量与特征列
        self.combo_target.clear()
        self.combo_target.addItems(self.df.columns.tolist())
        if len(self.df.columns) > 0:
            self.combo_target.setCurrentIndex(len(self.df.columns) - 1)

        self.list_features.clear()
        for col in self.df.columns:
            self.list_features.addItem(col)
        # 默认全选特征
        for i in range(self.list_features.count()):
            self.list_features.item(i).setSelected(True)

        # 更新表格预览 (前20行)
        preview_df = self.df.head(20)
        self.table_preview.setRowCount(len(preview_df))
        self.table_preview.setColumnCount(len(preview_df.columns))
        self.table_preview.setHorizontalHeaderLabels(preview_df.columns.tolist())
        for i in range(len(preview_df)):
            for j, col in enumerate(preview_df.columns):
                val = str(preview_df.iloc[i, j])
                self.table_preview.setItem(i, j, QTableWidgetItem(val))

    def start_training(self):
        if self.df is None:
            QMessageBox.warning(self, "警告", "请先加载数据！")
            return
        
        target_col = self.combo_target.currentText()
        selected_items = self.list_features.selectedItems()
        feature_cols = [item.text() for item in selected_items]

        if not target_col or not feature_cols:
            QMessageBox.warning(self, "警告", "必须选择目标变量和至少一个特征列！")
            return

        if target_col in feature_cols:
            feature_cols.remove(target_col)

        selected_models = [m for m, chk in self.model_checks.items() if chk.isChecked()]
        if not selected_models:
            QMessageBox.warning(self, "警告", "请至少勾选一个模型！")
            return

        config = {
            'df': self.df,
            'target_col': target_col,
            'feature_cols': feature_cols,
            'problem_type': self.combo_problem_type.currentText(),
            'is_big_data': self.is_big_data,
            'auto_sample': True,
            'sample_n': 50000,
            'test_size': 0.2,
            'seed': 42,
            'num_impute': 'mean',
            'scale_method': self.combo_scale.currentText(),
            'cat_encode': self.combo_encoder.currentText(),
            'use_smote': False,
            'models': selected_models,
            'tune_method': '不调优',
            'cv_folds': 5,
            'n_jobs': 1,
            'param_grids': {},
            'output_dir': self.output_dir
        }

        self.btn_train.setEnabled(False)
        self.btn_cancel.setEnabled(True)
        self.progress_bar.setValue(0)
        self.table_summary.clear()

        self.worker = TrainWorker(config)
        self.worker.log_signal.connect(self.log)
        self.worker.progress_signal.connect(self.progress_bar.setValue)
        self.worker.finished_signal.connect(self.training_finished)
        self.worker.error_signal.connect(self.training_error)
        self.worker.start()

    def cancel_training(self):
        if hasattr(self, 'worker'):
            self.worker.is_cancelled = True
            self.log("正在请求取消训练...")

    def training_finished(self, output_data):
        self.btn_train.setEnabled(True)
        self.btn_cancel.setEnabled(False)
        self.progress_bar.setValue(100)

        self.training_results = output_data['results']
        self.best_model_name = output_data['best_model_name']
        self.best_pipeline = output_data['best_pipeline']

        if self.best_model_name:
            self.btn_batch_pred.setEnabled(True)
            self.btn_export_report.setEnabled(True)
            self.log(f"训练完成！最佳模型: {self.best_model_name}")
        else:
            self.log("没有模型成功训练完成。")

        self.update_summary_table()
        self.update_importance_table()
        self.update_detail_view()
        QMessageBox.information(self, "完成", "所有模型训练流程已结束！")

    def training_error(self, err_str):
        self.btn_train.setEnabled(True)
        self.btn_cancel.setEnabled(False)
        self.progress_bar.setValue(0)
        self.log(err_str)
        QMessageBox.critical(self, "训练异常", err_str)

    def update_summary_table(self):
        if not self.training_results:
            return
        
        models = list(self.training_results.keys())
        first_metrics = self.training_results[models[0]]['metrics']
        columns = list(first_metrics.keys())
        # 排除内部字段
        columns = [c for c in columns if c not in ['feature_importance', 'chart_paths']]

        self.table_summary.setRowCount(len(models))
        self.table_summary.setColumnCount(len(columns) + 1)
        self.table_summary.setHorizontalHeaderLabels(['模型名称'] + columns)

        for i, m_name in enumerate(models):
            self.table_summary.setItem(i, 0, QTableWidgetItem(m_name))
            m_metrics = self.training_results[m_name]['metrics']
            for j, col in enumerate(columns):
                val = str(m_metrics.get(col, 'N/A'))
                self.table_summary.setItem(i, j + 1, QTableWidgetItem(val))

    def update_importance_table(self):
        # 寻找第一个带特征重要性的成功模型
        all_imp = []
        for m_name, res in self.training_results.items():
            imp = res['metrics'].get('feature_importance', [])
            if imp:
                for item in imp:
                    all_imp.append({
                        '模型名称': m_name,
                        '特征名称': item['feature'],
                        '重要性': item['importance']
                    })
        
        if not all_imp:
            return

        self.table_importance.setRowCount(len(all_imp))
        self.table_importance.setColumnCount(3)
        self.table_importance.setHorizontalHeaderLabels(['模型名称', '特征名称', '重要性'])

        for i, row in enumerate(all_imp):
            self.table_importance.setItem(i, 0, QTableWidgetItem(row['模型名称']))
            self.table_importance.setItem(i, 1, QTableWidgetItem(row['特征名称']))
            self.table_importance.setItem(i, 2, QTableWidgetItem(str(row['重要性'])))

    def update_detail_view(self):
        detail_str = "=== 模型训练详情与指标汇总 ===\n\n"
        for m_name, res in self.training_results.items():
            detail_str += f"模型: {m_name}\n"
            for k, v in res['metrics'].items():
                if k not in ['feature_importance', 'chart_paths']:
                    detail_str += f"  {k}: {v}\n"
            detail_str += "\n"
        self.text_detail.setText(detail_str)

    def save_best_model(self):
        if self.best_pipeline is None:
            QMessageBox.warning(self, "警告", "当前没有训练好的最佳模型！")
            return
        file_path, _ = QFileDialog.getSaveFileName(self, "保存模型", "best_model.joblib", "Joblib Files (*.joblib)")
        if file_path:
            try:
                joblib.dump(self.best_pipeline, file_path)
                QMessageBox.information(self, "成功", f"模型已成功保存至:\n{file_path}")
                self.log(f"最佳模型已保存: {file_path}")
            except Exception as e:
                QMessageBox.critical(self, "保存失败", str(e))

    def load_external_model(self):
        file_path, _ = QFileDialog.getOpenFileName(self, "加载模型", "", "Joblib Files (*.joblib);;All Files (*)")
        if file_path:
            try:
                self.best_pipeline = joblib.load(file_path)
                self.btn_batch_pred.setEnabled(True)
                QMessageBox.information(self, "成功", "模型加载成功！")
                self.log(f"外部模型加载成功: {file_path}")
            except Exception as e:
                QMessageBox.critical(self, "加载失败", str(e))

    def batch_predict(self):
        if self.best_pipeline is None:
            QMessageBox.warning(self, "警告", "请先训练或加载模型！")
            return
        
        file_path, _ = QFileDialog.getOpenFileName(self, "选择预测文件", "", "CSV/Excel Files (*.csv *.xlsx *.xls)")
        if file_path:
            try:
                pred_df, _, _ = DataLoaderEngine.load_file(file_path)
                # 预测
                preds = self.best_pipeline.predict(pred_df)
                pred_df['预测结果'] = preds

                out_csv = file_path + "_predicted.csv"
                pred_df.to_csv(out_csv, index=False, encoding='utf-8-sig')
                self.log(f"批量预测完成，结果已导出至: {out_csv}")
                QMessageBox.information(self, "成功", f"预测完成！\n结果文件已保存至:\n{out_csv}")
            except Exception as e:
                QMessageBox.critical(self, "批量预测异常", str(e))

    def export_report(self):
        if not self.training_results:
            QMessageBox.warning(self, "警告", "没有可导出的训练结果！")
            return
        
        dir_path = QFileDialog.getExistingDirectory(self, "选择报告保存目录")
        if dir_path:
            try:
                summary_data = []
                for m_name, res in self.training_results.items():
                    m_metrics = res['metrics'].copy()
                    m_metrics.pop('feature_importance', None)
                    m_metrics.pop('chart_paths', None)
                    m_metrics['模型名称'] = m_name
                    summary_data.append(m_metrics)
                    
                    # 保存单个模型
                    if res['pipeline'] is not None:
                        joblib.dump(res['pipeline'], os.path.join(dir_path, f"{m_name}_model.joblib"))

                sum_df = pd.DataFrame(summary_data)
                sum_df.to_csv(os.path.join(dir_path, "model_summary.csv"), index=False, encoding='utf-8-sig')

                # 生成简单 HTML 报告
                html_content = f"""
                <html>
                <head><meta charset="utf-8"><title>机器学习建模报告</title></head>
                <body>
                <h1>机器学习基础建模平台 - 训练报告</h1>
                <p>生成时间: {datetime.now().strftime("%Y-%m-%d %H:%M:%S")}</p>
                <h2>模型汇总指标</h2>
                {sum_df.to_html(index=False)}
                </body>
                </html>
                """
                with open(os.path.join(dir_path, "report.html"), "w", encoding="utf-8") as f:
                    f.write(html_content)

                QMessageBox.information(self, "成功", f"完整报告与模型已导出至:\n{dir_path}")
                self.log(f"导出报告成功: {dir_path}")
            except Exception as e:
                QMessageBox.critical(self, "导出异常", str(e))


