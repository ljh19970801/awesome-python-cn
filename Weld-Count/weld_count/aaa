# 1. 核心数据解析与加载引擎
# ==========================================
class DataLoaderEngine:
    @staticmethod
    def smart_read_csv(file_path):
        """增强型CSV读取，支持自动编码检测、BOM、NUL清理及多分隔符嗅探"""
        encodings = ['utf-8', 'gbk', 'gb18030', 'utf-16', 'big5', 'utf-8-sig']
        raw_bytes = None
        
        # 1. 读取二进制并处理 NUL 字节与编码
        try:
            with open(file_path, 'rb') as f:
                raw_bytes = f.read()
        except Exception as e:
            raise RuntimeError(f"文件无法读取: {str(e)}")

        # 检查是否包含带 BOM 的 UTF-16/32
        detected_enc = 'utf-8'
        for enc in encodings:
            try:
                raw_bytes.decode(enc)
                detected_enc = enc
                break
            except UnicodeDecodeError:
                continue

        # 清理非 UTF-16 的 NUL 字节
        if '16' not in detected_enc.lower():
            raw_bytes = raw_bytes.replace(b'\x00', b'')

        # 2. 分隔符嗅探
        delimiters = [',', ';', '\t', '|']
        best_sep = ','
        max_cols = 0
        
        text_sample = raw_bytes[:4096].decode(detected_enc, errors='ignore')
        for sep in delimiters:
            lines = text_sample.splitlines()
            if len(lines) > 0:
                cols = len(lines[0].split(sep))
                if cols > max_cols:
                    max_cols = cols
                    best_sep = sep

        # 3. 尝试 pandas 读取
        import io
        df = None
        last_err = None
        for enc in [detected_enc] + encodings:
            try:
                df = pd.read_csv(io.BytesIO(raw_bytes), encoding=enc, sep=best_sep, engine='python')
                break
            except Exception as e:
                last_err = e
                try:
                    df = pd.read_csv(io.BytesIO(raw_bytes), encoding=enc, sep=None, engine='python')
                    break
                except Exception as e2:
                    last_err = e2

        if df is None:
            # 逐行兜底解析
            try:
                lines = text_sample.splitlines()
                parsed_rows = [line.split(best_sep) for line in lines if line.strip()]
                if parsed_rows:
                    df = pd.DataFrame(parsed_rows[1:], columns=parsed_rows[0])
            except Exception as line_err:
                raise RuntimeError(f"CSV完全解析失败: {str(last_err)} | 逐行兜底失败: {str(line_err)}")

        # 去除全空列
        df = df.dropna(how='all', axis=1)
        return df, detected_enc, best_sep

    @staticmethod
    def load_file(file_path):
        ext = os.path.splitext(file_path)[1].lower()
        if ext in ['.csv', '.txt']:
            return DataLoaderEngine.smart_read_csv(file_path)
        elif ext in ['.xls', '.xlsx']:
            try:
                df = pd.read_excel(file_path, engine='openpyxl')
            except Exception:
                with open(file_path, 'rb') as f:
                    content = f.read()
                import io
                df = pd.read_excel(io.BytesIO(content))
            return df, 'excel', 'sheet'
        else:
            # 默认尝试 CSV
            return DataLoaderEngine.smart_read_csv(file_path)


