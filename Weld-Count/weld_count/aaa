# 2. 后台训练工作线程
# ==========================================
class TrainWorker(QThread):
    log_signal = pyqtSignal(str)
    progress_signal = pyqtSignal(int)
    finished_signal = pyqtSignal(dict)
    error_signal = pyqtSignal(str)

    def __init__(self, config):
        super().__init__()
        self.config = config
        self.is_cancelled = False

    def run(self):
        try:
            self.log_signal.emit("=== 训练任务初始化 ===")
            df = self.config['df'].copy()
            target_col = self.config['target_col']
            feature_cols = self.config['feature_cols']
            problem_type = self.config['problem_type']
            
            # 目标列检查
            if target_col in df.columns:
                initial_len = len(df)
                df = df.dropna(subset=[target_col])
                dropped = initial_len - len(df)
                if dropped > 0:
                    self.log_signal.emit(f"自动删除目标变量为空的行数: {dropped}")

            X = df[feature_cols]
            y = df[target_col]

            # 自动判定问题类型
            if problem_type == "自动检测":
                if pd.api.types.is_numeric_dtype(y) and y.nunique() > 20:
                    problem_type = "回归"
                else:
                    problem_type = "分类"
            self.log_signal.emit(f"确定问题类型: {problem_type}")

            # 大数据集自动采样
            is_big_data = self.config.get('is_big_data', False)
            if is_big_data and self.config.get('auto_sample', True):
                sample_n = min(self.config.get('sample_n', 50000), len(df))
                if sample_n < len(df):
                    if problem_type == "分类" and y.nunique() > 1:
                        try:
                            df, _ = train_test_split(df, train_size=sample_n, stratify=y, random_state=self.config.get('seed', 42))
                        except Exception:
                            df = df.sample(n=sample_n, random_state=self.config.get('seed', 42))
                    else:
                        df = df.sample(n=sample_n, random_state=self.config.get('seed', 42))
                    X = df[feature_cols]
                    y = df[target_col]
                    self.log_signal.emit(f"大数据集自动采样后数据量: {len(df)}")

            # 数据预处理流水线搭建
            numeric_features = X.select_dtypes(include=['int64', 'float64', 'int32', 'float32']).columns.tolist()
            categorical_features = [c for c in feature_cols if c not in numeric_features]

            # 缺失值与缩放配置
            num_impute_strategy = self.config.get('num_impute', 'mean')
            scale_method = self.config.get('scale_method', 'StandardScaler')
            
            num_transformer_steps = [('imputer', SimpleImputer(strategy='mean' if num_impute_strategy=='mean' else ('median' if num_impute_strategy=='median' else 'constant')))]
            if scale_method == 'StandardScaler':
                num_transformer_steps.append(('scaler', StandardScaler()))
            elif scale_method == 'MinMaxScaler':
                num_transformer_steps.append(('scaler', MinMaxScaler()))
            elif scale_method == 'RobustScaler':
                num_transformer_steps.append(('scaler', RobustScaler()))
            elif scale_method == 'PowerTransformer':
                num_transformer_steps.append(('scaler', PowerTransformer()))
            
            num_transformer = Pipeline(steps=num_transformer_steps)

            cat_encode_method = self.config.get('cat_encode', '独热编码')
            if cat_encode_method == '独热编码':
                cat_transformer = Pipeline(steps=[
                    ('imputer', SimpleImputer(strategy='constant', fill_value='missing')),
                    ('onehot', OneHotEncoder(handle_unknown='ignore', sparse_output=False))
                ])
            elif cat_encode_method == '目标编码' and HAS_CE:
                cat_transformer = Pipeline(steps=[
                    ('imputer', SimpleImputer(strategy='constant', fill_value='missing')),
                    ('target_enc', ce.TargetEncoder())
                ])
            else:
                cat_transformer = Pipeline(steps=[
                    ('imputer', SimpleImputer(strategy='constant', fill_value='missing')),
                    ('ordinal', OrdinalEncoder(handle_unknown='use_encoded_value', unknown_value=-1))
                ])

            preprocessor = ColumnTransformer(
                transformers=[
                    ('num', num_transformer, numeric_features),
                    ('cat', cat_transformer, categorical_features)
                ], remainder='drop'
            )

            # 数据集划分
            test_size = self.config.get('test_size', 0.2)
            seed = self.config.get('seed', 42)
            
            if problem_type == "分类" and y.nunique() > 1:
                try:
                    X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=test_size, stratify=y, random_state=seed)
                except Exception:
                    X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=test_size, random_state=seed)
            else:
                X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=test_size, random_state=seed)

            # SMOTE 过采样
            if problem_type == "分类" and self.config.get('use_smote', False) and HAS_IMBLEARN:
                try:
                    # 先预处理再 SMOTE
                    preprocessor.fit(X_train)
                    X_train_trans = preprocessor.transform(X_train)
                    smote = SMOTE(random_state=seed)
                    X_train_trans, y_train = smote.fit_resample(X_train_trans, y_train)
                    # 重建简化管道
                    from sklearn.preprocessing import FunctionTransformer
                    preprocessor = FunctionTransformer(func=lambda x: x, validate=False)
                    X_train = X_train_trans
                    self.log_signal.emit(f"SMOTE过采样完成，训练集大小: {len(X_train)}")
                except Exception as e:
                    self.log_signal.emit(f"SMOTE执行失败，跳过: {str(e)}")

            self.log_signal.emit(f"训练集样本数: {len(X_train)}, 测试集样本数: {len(X_test)}")

            # 模型定义
            models_to_run = self.config.get('models', [])
            results = {}
            best_score = -999999 if problem_type == "分类" else 999999
            best_model_name = None
            best_pipeline = None

            total_models = len(models_to_run)
            os.makedirs(self.config['output_dir'], exist_ok=True)

            for idx, m_name in enumerate(models_to_run):
                if self.is_cancelled:
                    self.log_signal.emit("训练已被用户取消")
                    break

                self.log_signal.emit(f"\n--- 开始训练模型: {m_name} ({idx+1}/{total_models}) ---")
                start_t = time.time()

                try:
                    # 实例化模型
                    model = self.get_model_instance(m_name, problem_type, seed)
                    if model is None:
                        self.log_signal.emit(f"模型 {m_name} 依赖未安装或不支持，跳过。")
                        continue

                    pipeline = Pipeline(steps=[('preprocessor', preprocessor), ('model', model)])

                    # 调优参数
                    tune_method = self.config.get('tune_method', '不调优')
                    cv_folds = self.config.get('cv_folds', 5)
                    
                    if tune_method in ['网格搜索', '随机搜索'] and m_name in self.config.get('param_grids', {}):
                        param_grid = self.config['param_grids'][m_name]
                        if param_grid:
                            scoring = 'f1_macro' if problem_type == '分类' else 'neg_root_mean_squared_error'
                            if tune_method == '网格搜索':
                                search = GridSearchCV(pipeline, param_grid, cv=cv_folds, scoring=scoring, n_jobs=self.config.get('n_jobs', 1))
                            else:
                                search = RandomizedSearchCV(pipeline, param_grid, n_iter=10, cv=cv_folds, scoring=scoring, random_state=seed, n_jobs=self.config.get('n_jobs', 1))
                            search.fit(X_train, y_train)
                            pipeline = search.best_estimator_
                            self.log_signal.emit(f"{m_name} 调优完成，最佳参数: {search.best_params_}")
                        else:
                            pipeline.fit(X_train, y_train)
                    else:
                        pipeline.fit(X_train, y_train)

                    train_time = time.time() - start_t
                    
                    # 预测与评估
                    y_pred = pipeline.predict(X_test)
                    metrics = self.evaluate_metrics(y_test, y_pred, pipeline, X_test, problem_type)
                    metrics['训练时间'] = round(train_time, 2)
                    metrics['状态'] = '成功'

                    # 特征重要性提取
                    feature_importance = self.extract_feature_importance(pipeline, feature_cols)
                    metrics['feature_importance'] = feature_importance

                    # 生成图表
                    chart_paths = self.generate_charts(pipeline, X_test, y_test, y_pred, m_name, problem_type, self.config['output_dir'])
                    metrics['chart_paths'] = chart_paths

                    results[m_name] = {
                        'pipeline': pipeline,
                        'metrics': metrics
                    }

                    # 判定最佳模型
                    if problem_type == '回归':
                        score_val = metrics.get('RMSE', 999999)
                        if score_val < best_score:
                            best_score = score_val
                            best_model_name = m_name
                            best_pipeline = pipeline
                    else:
                        score_val = metrics.get('F1', 0)
                        if score_val > best_score:
                            best_score = score_val
                            best_model_name = m_name
                            best_pipeline = pipeline

                    self.log_signal.emit(f"模型 {m_name} 训练成功，耗时 {train_time:.2f}s")
                except Exception as ex:
                    err_msg = str(ex)
                    self.log_signal.emit(f"模型 {m_name} 训练失败: {err_msg}")
                    self.log_signal.emit(traceback.format_exc())
                    results[m_name] = {
                        'pipeline': None,
                        'metrics': {'状态': f'失败: {err_msg[:30]}', '训练时间': 0}
                    }

                self.progress_signal.emit(int((idx + 1) / total_models * 100))

            output_data = {
                'results': results,
                'best_model_name': best_model_name,
                'best_pipeline': best_pipeline,
                'problem_type': problem_type,
                'X_test': X_test,
                'y_test': y_test
            }
            self.finished_signal.emit(output_data)
        except Exception as e:
            self.error_signal.emit(f"训练流程全局异常: {str(e)}\n{traceback.format_exc()}")

    def get_model_instance(self, name, problem_type, seed):
        if problem_type == '回归':
            if name == 'LinearRegression': return LinearRegression()
            elif name == 'RandomForest': return RandomForestRegressor(random_state=seed)
            elif name == 'GradientBoosting': return GradientBoostingRegressor(random_state=seed)
            elif name == 'XGBoost': return xgb.XGBRegressor(random_state=seed) if HAS_XGBOOST else None
            elif name == 'LightGBM': return lgb.LGBMRegressor(random_state=seed, verbose=-1) if HAS_LIGHTGBM else None
            elif name == 'CatBoost': return cb.CatBoostRegressor(random_state=seed, verbose=0) if HAS_CATBOOST else None
            elif name == 'SGD': return SGDRegressor(random_state=seed)
        else:
            if name == 'LogisticRegression': return LogisticRegression(random_state=seed, max_iter=1000)
            elif name == 'RandomForest': return RandomForestClassifier(random_state=seed)
            elif name == 'GradientBoosting': return GradientBoostingClassifier(random_state=seed)
            elif name == 'XGBoost': return xgb.XGBClassifier(random_state=seed) if HAS_XGBOOST else None
            elif name == 'LightGBM': return lgb.LGBMClassifier(random_state=seed, verbose=-1) if HAS_LIGHTGBM else None
            elif name == 'CatBoost': return cb.CatBoostClassifier(random_state=seed, verbose=0) if HAS_CATBOOST else None
            elif name == 'SGD': return SGDClassifier(random_state=seed)
        return None

    def evaluate_metrics(self, y_true, y_pred, pipeline, X_test, problem_type):
        metrics = {}
        y_true_arr = np.array(y_true)
        if problem_type == '回归':
            metrics['MAE'] = round(mean_absolute_error(y_true_arr, y_pred), 4)
            metrics['MSE'] = round(mean_squared_error(y_true_arr, y_pred), 4)
            metrics['RMSE'] = round(np.sqrt(metrics['MSE']), 4)
            metrics['R²'] = round(r2_score(y_true_arr, y_pred), 4)
            metrics['解释方差'] = round(explained_variance_score(y_true_arr, y_pred), 4)
            
            diff = y_pred - y_true_arr
            metrics['MBE'] = round(np.mean(diff), 4)
            metrics['MBE%'] = round(np.mean(diff / (np.abs(y_true_arr) + 1e-9)) * 100, 2)
            
            nonzero_mask = y_true_arr != 0
            if np.any(nonzero_mask):
                nz_true = y_true_arr[nonzero_mask]
                nz_pred = y_pred[nonzero_mask]
                metrics['MAPE%'] = round(np.mean(np.abs((nz_true - nz_pred) / nz_true)) * 100, 2)
                rel_err = np.abs(nz_true - nz_pred) / np.abs(nz_true)
                metrics['WER0.5%'] = round(np.mean(rel_err <= 0.005) * 100, 2)
                metrics['最大相对误差%'] = round(np.max(rel_err) * 100, 2)
            else:
                metrics['MAPE%'] = 0.0
                metrics['WER0.5%'] = 0.0
                metrics['最大相对误差%'] = 0.0
        else:
            metrics['准确率'] = round(accuracy_score(y_true_arr, y_pred), 4)
            metrics['精确率'] = round(precision_score(y_true_arr, y_pred, average='macro', zero_division=0), 4)
            metrics['召回率'] = round(recall_score(y_true_arr, y_pred, average='macro', zero_division=0), 4)
            metrics['F1'] = round(f1_score(y_true_arr, y_pred, average='macro', zero_division=0), 4)
            
            try:
                if hasattr(pipeline, "predict_proba"):
                    proba = pipeline.predict_proba(X_test)
                    if proba.shape[1] == 2:
                        metrics['ROC_AUC'] = round(roc_auc_score(y_true_arr, proba[:, 1]), 4)
                    else:
                        metrics['ROC_AUC'] = round(roc_auc_score(y_true_arr, proba, multi_class='ovr', average='macro'), 4)
                else:
                    metrics['ROC_AUC'] = 0.0
            except Exception:
                metrics['ROC_AUC'] = 0.0
        return metrics

    def extract_feature_importance(self, pipeline, feature_cols):
        importances = []
        try:
            model = pipeline.named_steps['model']
            if hasattr(model, 'feature_importances_'):
                imp = model.feature_importances_
                for name, val in zip(feature_cols, imp[:len(feature_cols)]):
                    importances.append({'feature': name, 'importance': float(val)})
            elif hasattr(model, 'coef_'):
                coef = model.coef_
                if coef.ndim > 1:
                    coef = np.mean(np.abs(coef), axis=0)
                else:
                    coef = np.abs(coef)
                for name, val in zip(feature_cols, coef[:len(feature_cols)]):
                    importances.append({'feature': name, 'importance': float(val)})
            importances = sorted(importances, key=lambda x: abs(x['importance']), reverse=True)
        except Exception:
            pass
        return importances

    def generate_charts(self, pipeline, X_test, y_test, y_pred, model_name, problem_type, output_dir):
        chart_paths = {}
        try:
            plt.figure(figsize=(6, 5))
            if problem_type == '回归':
                plt.scatter(y_test, y_pred, alpha=0.6, color='b')
                plt.plot([y_test.min(), y_test.max()], [y_test.min(), y_test.max()], 'r--', lw=2)
                plt.xlabel('真实值')
                plt.ylabel('预测值')
                plt.title(f'{model_name} - 真实值 vs 预测值')
                p1 = os.path.join(output_dir, f'{model_name}_scatter.png')
                plt.savefig(p1, bbox_inches='tight')
                plt.close()
                chart_paths['散点图'] = p1

                plt.figure(figsize=(6, 5))
                residuals = y_test - y_pred
                plt.hist(residuals, bins=30, color='g', alpha=0.7)
                plt.xlabel('残差')
                plt.ylabel('频数')
                plt.title(f'{model_name} - 残差分布图')
                p2 = os.path.join(output_dir, f'{model_name}_residual.png')
                plt.savefig(p2, bbox_inches='tight')
                plt.close()
                chart_paths['残差图'] = p2
            else:
                plt.figure(figsize=(6, 5))
                cm = confusion_matrix(y_test, y_pred)
                plt.imshow(cm, interpolation='nearest', cmap=plt.cm.Blues)
                plt.title(f'{model_name} - 混淆矩阵')
                plt.colorbar()
                plt.xlabel('预测标签')
                plt.ylabel('真实标签')
                p1 = os.path.join(output_dir, f'{model_name}_cm.png')
                plt.savefig(p1, bbox_inches='tight')
                plt.close()
                chart_paths['混淆矩阵'] = p1
        except Exception as e:
            print(f"生成图表异常: {e}")
        return chart_paths


